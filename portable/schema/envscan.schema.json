{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "envscan/1",
  "title": "envscan report",
  "description": "Output of envscan.ps1 and envscan.sh. Probe data shapes are documented in docs/DEVELOPING.md; missing data means unknown, never absent.",
  "type": "object",
  "required": ["schema", "scanner", "run", "host", "findings", "probes"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "envscan/1" },
    "scanner": {
      "type": "object",
      "required": ["name", "version", "impl", "shell_version"],
      "additionalProperties": false,
      "properties": {
        "name": { "const": "envscan" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "impl": { "enum": ["powershell", "posix-sh", "jscript", "go"] },
        "shell_version": { "type": "string" }
      }
    },
    "run": {
      "type": "object",
      "required": ["started_utc", "finished_utc", "duration_ms", "tiers", "flags", "cwd", "out_dir", "exit_code", "redaction", "counts"],
      "additionalProperties": false,
      "properties": {
        "started_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}" },
        "finished_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "tiers": { "type": "array", "items": { "enum": ["default", "deep", "net"] } },
        "flags": { "type": "array", "items": { "type": "string" } },
        "cwd": { "type": "string" },
        "out_dir": { "type": "string" },
        "exit_code": { "enum": [0, 1, 2] },
        "redaction": { "type": "boolean" },
        "test_root": { "type": "string" },
        "counts": {
          "type": "object",
          "required": ["ok", "partial", "not_found", "not_applicable", "denied", "timeout", "error", "skipped"],
          "additionalProperties": false,
          "properties": {
            "ok": { "type": "integer" }, "partial": { "type": "integer" }, "not_found": { "type": "integer" },
            "not_applicable": { "type": "integer" }, "denied": { "type": "integer" }, "timeout": { "type": "integer" },
            "error": { "type": "integer" }, "skipped": { "type": "integer" }
          }
        }
      }
    },
    "host": {
      "type": "object",
      "required": ["os_family", "os_name", "os_version", "arch", "hostname"],
      "additionalProperties": false,
      "properties": {
        "os_family": { "enum": ["windows", "linux", "darwin", "freebsd", "openbsd", "netbsd", "aix", "sunos", "hpux", "cygwin", "zos", "os400", "other"] },
        "os_name": { "type": "string" },
        "os_version": { "type": "string" },
        "arch": { "enum": ["x86_64", "x86", "arm64", "arm", "ppc64", "ppc64le", "ppc", "s390x", "riscv64", "sparc64", "sparc", "ia64", "mips", "other"] },
        "hostname": { "type": "string" }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "title", "detail", "recommendation", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$" },
          "severity": { "enum": ["blocker", "warning", "info"] },
          "title": { "type": "string" },
          "detail": { "type": "string" },
          "recommendation": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/probe" }
    }
  },
  "$defs": {
    "probe": {
      "type": "object",
      "required": ["status", "tier", "scope", "title", "sources", "duration_ms", "data"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["ok", "partial", "not_found", "not_applicable", "denied", "timeout", "error", "skipped"] },
        "tier": { "enum": ["default", "deep", "net"] },
        "scope": { "enum": ["machine", "user", "process", "mixed"] },
        "title": { "type": "string" },
        "sources": { "type": "array", "items": { "type": "string" } },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "data": { "type": "object" },
        "raw": { "type": "object", "additionalProperties": { "type": "string" } },
        "truncated": { "type": "boolean" },
        "error": { "type": ["string", "null"] },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
